{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/lucques/eskuel-suite/master/spec/game-package-recipe/v1/recipe.schema.json",
    "title": "Eskuel game-package authoring recipe 1",
    "description": "The strict authoring input consumed by eskuelgame pack to create one game-package v1 archive.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "name",
        "title",
        "version",
        "contributors",
        "licenses"
    ],
    "properties": {
        "$schema": {
            "const": "https://raw.githubusercontent.com/lucques/eskuel-suite/master/spec/game-package-recipe/v1/recipe.schema.json"
        },
        "name": {
            "$ref": "../../game-package/v1/datapackage.schema.json#/properties/name"
        },
        "title": {
            "$ref": "../../game-package/v1/datapackage.schema.json#/properties/title"
        },
        "version": {
            "$ref": "../../game-package/v1/datapackage.schema.json#/properties/version"
        },
        "contributors": {
            "$ref": "../../game-package/v1/datapackage.schema.json#/properties/contributors"
        },
        "licenses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/definitions/recipeLicense"
            }
        },
        "notices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/definitions/recipeNotice"
            }
        },
        "provenance": {
            "$ref": "#/definitions/recipeProvenance"
        },
        "sources": {
            "$ref": "../../game-package/v1/datapackage.schema.json#/properties/sources"
        }
    },
    "definitions": {
        "portableInputPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*\\u0000)(?!\\.)(?!.*/\\.)[^/]+(?:/[^/]+)*$"
        },
        "recipeLicense": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "inputPath"
            ],
            "properties": {
                "name": {
                    "$ref": "../../game-package/v1/datapackage.schema.json#/definitions/nonEmptyString"
                },
                "path": {
                    "$ref": "../../game-package/v1/datapackage.schema.json#/definitions/licensePath"
                },
                "title": {
                    "$ref": "../../game-package/v1/datapackage.schema.json#/definitions/nonEmptyString"
                },
                "inputPath": {
                    "$ref": "#/definitions/portableInputPath"
                }
            }
        },
        "recipeNotice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "inputPath"
            ],
            "properties": {
                "path": {
                    "$ref": "../../game-package/v1/datapackage.schema.json#/definitions/noticePath"
                },
                "title": {
                    "$ref": "../../game-package/v1/datapackage.schema.json#/definitions/nonEmptyString"
                },
                "inputPath": {
                    "$ref": "#/definitions/portableInputPath"
                }
            }
        },
        "recipeProvenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "mediatype",
                "inputPath"
            ],
            "properties": {
                "path": {
                    "$ref": "../../game-package/v1/datapackage.schema.json#/definitions/provenancePath"
                },
                "mediatype": {
                    "$ref": "../../game-package/v1/datapackage.schema.json#/definitions/provenanceMediatype"
                },
                "inputPath": {
                    "$ref": "#/definitions/portableInputPath"
                }
            }
        }
    }
}
