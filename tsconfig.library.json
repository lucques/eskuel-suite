{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "allowImportingTsExtensions": false,
        "rootDir": ".",
        "outDir": "./dist/library",
        "types": ["vite/client"]
    },
    "include": [
        "src/embed.ts",
        "src/**/*.worker.ts",
        "src/vite-env.d.ts",
        "src/i18n/i18next.d.ts"
    ]
}
