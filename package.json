{
  "name": "eskuel-suite",
  "description": "A library for building web-based educational material for SQL",
  "version": "2.0.1",
  "contributors": [
    {
      "name": "Lukas Convent",
      "url": "https://lukas.convnet.de"
    }
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucques/eskuel-suite.git"
  },
  "homepage": "https://eskuel.de",
  "bugs": {
    "url": "https://github.com/lucques/eskuel-suite/issues"
  },
  "bin": {
    "eskueldb": "dist-cli/eskueldb.mjs",
    "eskuelgame": "dist-cli/eskuelgame.mjs",
    "eskuel-play": "dist-cli/eskuel-play.mjs",
    "eskuel-review": "dist-cli/eskuel-review.mjs"
  },
  "type": "module",
  "main": "./dist/library/src/embed.js",
  "types": "./dist/library/eskuel-suite.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/eskuel-suite.d.ts",
      "import": "./dist/library/src/embed.js"
    },
    "./style.css": {
      "types": "./dist/library/style.css.d.ts",
      "default": "./dist/embed/eskuel-suite.css"
    },
    "./embed/*": "./dist/embed/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/embed",
    "dist/library",
    "dist-cli",
    "doc",
    "spec",
    "public/res/games",
    "public/res/dbs/fahrschule.sql",
    "public/res/dbs/onlineshop.sql",
    "public/res/dbs/driving-school.sql",
    "public/res/dbs/online-shop.sql",
    "COPYING",
    "THIRD_PARTY_LICENSES"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:app && npm run build:embed && npm run build:cli",
    "build:app": "npm run licenses:check && vite build",
    "build:embed": "npm run licenses:check && vite build --config vite.embed.config.ts && npm run build:library",
    "build:library": "node ./bin/build-library.ts",
    "build:cli": "node -e \"require('node:fs').rmSync('dist-cli', { recursive: true, force: true })\" && npm run eskueldb:bundle && npm run eskuelgame:bundle && npm run game-cli:bundle",
    "licenses:generate": "node ./bin/generate-third-party-licenses.ts",
    "licenses:check": "node ./bin/generate-third-party-licenses.ts --check",
    "eskueldb": "npm run eskueldb:bundle && node ./dist-cli/eskueldb.mjs",
    "eskueldb:bundle": "vite build --config bin/eskueldb.vite.config.ts",
    "eskueldb:link": "npm run eskueldb:bundle && npm link",
    "eskuelgame": "npm run eskuelgame:bundle && node ./dist-cli/eskuelgame.mjs",
    "eskuelgame:bundle": "vite build --config bin/eskuelgame.vite.config.ts",
    "eskuelgame:link": "npm run eskuelgame:bundle && npm link",
    "eskuel-play": "npm run game-cli:bundle && node ./dist-cli/eskuel-play.mjs",
    "eskuel-review": "npm run game-cli:bundle && node ./dist-cli/eskuel-review.mjs",
    "game-cli:bundle": "vite build --config bin/game-cli.vite.config.ts",
    "database-package-examples:generate": "node ./bin/generate-database-package-examples.ts",
    "game-package-examples:generate": "node ./bin/generate-game-package-examples.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --project unit",
    "test:vitest": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration-node --project integration-webbrowser",
    "test:integration:node": "vitest run --project integration-node",
    "test:integration:webbrowser": "vitest run --project integration-webbrowser",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:distribution": "playwright test --config playwright.distribution.config.ts",
    "test:install-browsers": "playwright install chromium",
    "test:coverage": "vitest run --project unit --project integration-node --project integration-webbrowser --coverage",
    "test:all": "npm run licenses:check && npm run typecheck && npm run lint && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.tooling.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepack": "npm run build:embed && npm run build:cli",
    "upload-to-strato": "./bin/upload-to-strato.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@hello-pangea/dnd": "^18.0.1",
    "@monaco-editor/react": "^4.7.0-rc.0",
    "@types/sql.js": "^1.4.9",
    "ajv": "^6.15.0",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "classnames": "^2.5.1",
    "dockview-core": "^6.6.1",
    "dockview-react": "^6.6.1",
    "effect": "^3.22.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "he": "^1.2.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-syntax-highlighter": "^16.1.0",
    "react18-json-view": "^0.2.9",
    "sql.js": "^1.14.0",
    "string-hash": "^1.1.3",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@effect/vitest": "^0.27.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.62.1",
    "@types/he": "^1.2.3",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@types/string-hash": "^1.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "postcss-custom-media": "^12.0.1",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^3.2.7",
    "vitest-browser-react": "^1.0.1"
  }
}
